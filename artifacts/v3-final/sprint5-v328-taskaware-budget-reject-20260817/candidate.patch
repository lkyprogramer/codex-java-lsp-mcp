@@ -0,0 +1,256 @@
+#!/usr/bin/env node
+// input: three real Java repositories (already-cloned worktrees the caller owns) and one
+//   real-symbol anchor per repo (file/line/column of an identifier with real references).
+// output: fresh-workspace, prepare=none, references first-touch phase timings and peak JDT
+//   java-process RSS/%CPU for JAVA_LSP_IMPORT_CONCURRENCY=2 (current machine default) vs 8,
+//   per repo, run interleaved per repo (2-batch then 8-batch, not batched across all repos).
+// pos: V3.2-24 pass 1 (import concurrency single-variable sweep, development-plan Sprint4).
+//   Deliberately reuses src/benchmark/semantic-first-touch.ts (Task 35) unmodified through the
+//   standard two-layer isolation chain, following the exact proven invocation this Sprint used
+//   for run-idle-prewarm-experiment.mjs (V3.2-23) - no production src/ changes, so this script
+//   does not touch the LOC ledger.
+import { spawn, execFile } from "node:child_process";
+import { mkdir, writeFile, appendFile } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { promisify } from "node:util";
+
+const execFileAsync = promisify(execFile);
+const scriptRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const JDT_MATCH = "org.eclipse.jdt.ls.core.id1";
+const SAMPLE_INTERVAL_MS = 300;
+// 2026-08-16 pass 1 hit host load average ~30 on this 10-core machine (Time Machine backup +
+// heavy desktop multitasking) and got two 60s DEADLINE_EXCEEDED attempts with zero results,
+// versus Task36's clean ~22-26s baseline for the same repo/anchor/timeout - a load this high
+// invalidates any comparison. Refuse to start rather than produce noise that looks like data.
+const MAX_LOADAVG_PER_CPU = 0.7;
+
+const ANCHORS = {
+  cipherlink: {
+    file: "modules/organization/src/main/java/com/hhtele/cipherlink/organization/application/DefaultOrganizationAppService.java",
+    line: 693,
+    column: 23
+  },
+  lishuedu: {
+    file: "modules/iam/src/main/java/com/lishu/edu/iam/application/service/InternalUserAppServiceImpl.java",
+    line: 37,
+    column: 14
+  },
+  "exam-parent-v3": {
+    file: "exam-service/exam-service-candidate/src/main/java/com/hhtele/exam/service/candidate/impl/OrgServiceImpl.java",
+    line: 26,
+    column: 14
+  }
+};
+
+const CONCURRENCY_ARMS = [2, 8];
+
+async function main() {
+  const cli = parseCli(process.argv.slice(2));
+  if (cli.help) return printUsage();
+  await mkdir(cli.outputDir, { recursive: true });
+  const results = {};
+  for (const project of Object.keys(ANCHORS)) {
+    const repoRoot = cli.repositories[project];
+    if (!repoRoot) throw new Error(`missing --${project} <repo root>`);
+    results[project] = {};
+    for (const concurrency of CONCURRENCY_ARMS) {
+      await assertNoStrayJdt();
+      await assertHostQuiet();
+      console.log(`v324-import-concurrency: ${project} concurrency=${concurrency} (runs=${cli.runs})`);
+      const cell = await runCondition({
+        project, repoRoot, concurrency, runs: cli.runs, anchor: ANCHORS[project], outputDir: cli.outputDir
+      });
+      results[project][String(concurrency)] = cell;
+      console.log(`v324-import-concurrency: ${project} concurrency=${concurrency} -> ${JSON.stringify(summarizeCell(cell))}`);
+    }
+  }
+  const summary = {
+    schemaVersion: "v32-import-concurrency-experiment/v1",
+    purpose: "V3.2-24 pass 1: does raising JAVA_LSP_IMPORT_CONCURRENCY from the current machine "
+      + "default (2, per resource-defaults.ts on this 32GB/10-core host) to 8 move fresh-workspace "
+      + "references first-touch phaseMs/totalMs or completion rate. Measurement-only.",
+    method: "workspaceState=fresh, prepare=none, operation=references, timeoutMs=60000 fixed "
+      + "throughout (matches the existing 2026-08-09 Task36 baseline at concurrency=2 for the same "
+      + "repos/anchors/timeout, so that data is reused as-is rather than re-run). Per repo, the "
+      + "concurrency=2 batch and concurrency=8 batch are run back-to-back (interleaved at the "
+      + "repo x arm grain, not batched across all 3 repos) to bound host-drift exposure to one "
+      + "repo's pair rather than the whole run, per advisor guidance during design.",
+    concurrencyArms: CONCURRENCY_ARMS,
+    runsPerCell: cli.runs,
+    results
+  };
+  await writeFile(path.join(cli.outputDir, "summary.json"), `${JSON.stringify(summary, null, 2)}\n`);
+  console.log(JSON.stringify(summary, null, 2));
+}
+
+function summarizeCell(cell) {
+  const totals = cell.attempts.filter(a => a.completion === "COMPLETE").map(a => a.totalMs).sort((a, b) => a - b);
+  return {
+    completions: `${totals.length}/${cell.attempts.length}`,
+    medianTotalMs: totals.length > 0 ? totals[Math.floor((totals.length - 1) / 2)] : null,
+    peakRssKb: cell.peakRssKb,
+    peakCpuPercent: cell.peakCpuPercent
+  };
+}
+
+async function runCondition({ project, repoRoot, concurrency, runs, anchor, outputDir }) {
+  const label = `${project}-c${concurrency}`;
+  const stdoutFile = path.join(outputDir, `${label}.stdout.log`);
+  const stderrFile = path.join(outputDir, `${label}.stderr.log`);
+  await writeFile(stdoutFile, "");
+  await writeFile(stderrFile, "");
+  const jdtlsBin = process.env.JDTLS_BIN ?? "/opt/homebrew/bin/jdtls";
+  const args = [
+    path.join(scriptRoot, "scripts", "run-isolated-validation.mjs"),
+    "--profile", "compile",
+    "--env", `JDTLS_BIN=${jdtlsBin}`,
+    "--env", `JAVA_LSP_IMPORT_CONCURRENCY=${String(concurrency)}`,
+    "--env", `JAVA_LSP_BENCH_ANCHOR_FILE=${anchor.file}`,
+    "--env", `JAVA_LSP_BENCH_ANCHOR_LINE=${String(anchor.line)}`,
+    "--env", `JAVA_LSP_BENCH_ANCHOR_COLUMN=${String(anchor.column)}`,
+    "--",
+    "node", "scripts/run-isolated-jdt-benchmark.mjs",
+    "--repo-root", repoRoot,
+    "--",
+    "node", "dist/benchmark/semantic-first-touch.js",
+    "--repo-root", "{repo}",
+    "--project-id", project,
+    "--workspace-state", "fresh",
+    "--operation", "references",
+    "--prepare", "none",
+    "--runs", String(runs),
+    "--timeout-ms", "60000"
+  ];
+  const sampler = startResourceSampler();
+  let stdoutBuffer = "";
+  const exitCode = await new Promise((resolve, reject) => {
+    const child = spawn("sh", [path.join(scriptRoot, "scripts", "run-isolated-node.sh"), ...args], {
+      cwd: scriptRoot,
+      env: process.env
+    });
+    child.stdout.on("data", chunk => {
+      stdoutBuffer += chunk.toString("utf8");
+      void appendFile(stdoutFile, chunk);
+    });
+    child.stderr.on("data", chunk => {
+      void appendFile(stderrFile, chunk);
+    });
+    child.once("error", reject);
+    child.once("exit", code => resolve(code));
+  });
+  sampler.stop();
+  if (exitCode !== 0) {
+    throw new Error(`${label} exited with code ${exitCode}; see ${stderrFile}`);
+  }
+  const payload = parsePayloadAfterStatusLines(stdoutBuffer, stdoutFile);
+  const resource = sampler.result();
+  return { attempts: payload.attempts, ...resource };
+}
+
+function parsePayloadAfterStatusLines(buffer, stdoutFile) {
+  const lines = buffer.split("\n");
+  const rest = lines.slice(2).join("\n");
+  try {
+    const parsed = JSON.parse(rest);
+    if (!Array.isArray(parsed?.attempts)) throw new Error("no attempts array");
+    return parsed;
+  } catch (error) {
+    throw new Error(`could not parse semantic-first-touch payload from stdout (see ${stdoutFile}): ${error.message}`);
+  }
+}
+
+function startResourceSampler() {
+  let peakRssKb = 0;
+  let peakCpuPercent = 0;
+  let sampleCount = 0;
+  let stopped = false;
+  let pending = false;
+  const timer = setInterval(() => {
+    if (stopped || pending) return;
+    pending = true;
+    void sampleOnce().finally(() => { pending = false; });
+  }, SAMPLE_INTERVAL_MS);
+  timer.unref();
+  async function sampleOnce() {
+    const pids = await findJdtPids();
+    for (const pid of pids) {
+      try {
+        const { stdout } = await execFileAsync("ps", ["-o", "rss=,%cpu=", "-p", pid]);
+        const [rssKb, cpuPercent] = stdout.trim().split(/\s+/).map(Number);
+        if (Number.isFinite(rssKb)) peakRssKb = Math.max(peakRssKb, rssKb);
+        if (Number.isFinite(cpuPercent)) peakCpuPercent = Math.max(peakCpuPercent, cpuPercent);
+      } catch {
+        // the process may have exited between pgrep and ps; skip this sample.
+      }
+    }
+    sampleCount += 1;
+  }
+  return {
+    stop() { stopped = true; clearInterval(timer); },
+    result() { return { peakRssKb, peakCpuPercent, sampleCount }; }
+  };
+}
+
+async function assertHostQuiet() {
+  const [loadavg1] = os.loadavg();
+  const perCpu = loadavg1 / os.cpus().length;
+  if (perCpu > MAX_LOADAVG_PER_CPU) {
+    throw new Error(
+      `refusing to start: 1-minute load average ${loadavg1.toFixed(2)} is ${perCpu.toFixed(2)}x logical `
+      + `CPU count (${os.cpus().length}); this benchmark requires a quiet host (<=${MAX_LOADAVG_PER_CPU}x) `
+      + "to produce a comparison worth trusting. Close background work (Time Machine, browsers, etc.) and retry."
+    );
+  }
+}
+
+async function assertNoStrayJdt() {
+  const pids = await findJdtPids();
+  if (pids.length > 0) {
+    throw new Error(
+      `refusing to start: found pre-existing JDT process(es) matching "${JDT_MATCH}" (pid(s) ${pids.join(",")}). `
+      + "This experiment requires no other JDT session running on the machine."
+    );
+  }
+}
+
+async function findJdtPids() {
+  try {
+    const { stdout } = await execFileAsync("pgrep", ["-f", JDT_MATCH]);
+    return stdout.split("\n").map(line => line.trim()).filter(Boolean);
+  } catch (error) {
+    if (error.code === 1) return [];
+    throw error;
+  }
+}
+
+function parseCli(args) {
+  const repositories = {};
+  let outputDir;
+  let runs = 5;
+  for (let index = 0; index < args.length; index += 1) {
+    const arg = args[index];
+    if (arg === "--help" || arg === "-h") return { help: true };
+    if (arg === "--output-dir") { outputDir = args[++index]; continue; }
+    if (arg === "--runs") { runs = Number.parseInt(args[++index], 10); continue; }
+    if (arg === "--lishuedu") { repositories.lishuedu = args[++index]; continue; }
+    if (arg === "--cipherlink") { repositories.cipherlink = args[++index]; continue; }
+    if (arg === "--exam-parent-v3") { repositories["exam-parent-v3"] = args[++index]; continue; }
+    throw new Error(`unknown argument: ${arg}`);
+  }
+  if (!outputDir) throw new Error("--output-dir is required");
+  if (!Number.isInteger(runs) || runs < 1) throw new Error("--runs must be a positive integer");
+  return { outputDir: path.resolve(outputDir), runs, repositories };
+}
+
+function printUsage() {
+  console.log("Usage: node scripts/run-v324-import-concurrency-experiment.mjs --output-dir DIR --lishuedu DIR --cipherlink DIR --exam-parent-v3 DIR [--runs 5]");
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  main().catch(error => {
+    console.error(error instanceof Error ? error.message : String(error));
+    process.exitCode = 1;
+  });
+}
