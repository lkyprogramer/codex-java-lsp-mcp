{
  "name": "codex-java-lsp-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "codex-java-lsp-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/write-build-stamp.mjs",
    "clean": "rm -rf dist",
    "test": "node --test \"dist/**/*.test.js\"",
    "benchmark:agent-impact": "node dist/benchmark-agent-impact.js",
    "benchmark:agent-summary": "node scripts/summarize-impact-benchmark.mjs",
    "benchmark:three-repo-matrix": "node scripts/run-three-repo-cold-matrix.mjs",
    "benchmark:three-repo-verify": "node scripts/verify-three-repo-cold-matrix.mjs",
    "benchmark:impact-attribution": "node scripts/attribute-impact-payload.mjs",
    "benchmark:lsp-performance": "node dist/benchmark-lsp-performance.js",
    "benchmark:edit-to-visible": "node scripts/edit-to-visible-benchmark.mjs",
    "smoke": "node dist/smoke.js",
    "smoke:lease-subprocess": "node scripts/lease-subprocess-smoke.mjs",
    "measure:tool-schema": "node scripts/measure-tool-schema.mjs",
    "test:three-repo-matrix": "node --test scripts/verify-three-repo-cold-matrix.test.mjs",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chokidar": "5.0.0",
    "fast-xml-parser": "5.10.1",
    "tree-sitter": "0.25.0",
    "tree-sitter-java": "0.23.5",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "zod": "^4.1.13"
  },
  "overrides": {
    "tree-sitter-java": {
      "tree-sitter": "0.25.0"
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
